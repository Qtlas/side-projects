// ============================================================
//  named.conf.local for the Juventus DNS
//  Authoritative for juv.wfl.lan and the reverse zone 172.20.132.0/24
//  Dynamic updates come from the local Kea DDNS (127.0.0.1)
// ============================================================

zone "juv.wfl.lan" {
    type master;
    file "/etc/bind/zones/db.juv.wfl.lan";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};

zone "132.20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.132.20.172";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};
