// ============================================================
//  named.conf.local for the Borussia Dortmund DNS
//  Authoritative for bvb.wfl.lan and the reverse zone 172.20.130.0/24
//  Dynamic updates come from the local Kea DDNS (127.0.0.1)
// ============================================================

zone "bvb.wfl.lan" {
    type master;
    file "/etc/bind/zones/db.bvb.wfl.lan";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};

zone "130.20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.130.20.172";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};
