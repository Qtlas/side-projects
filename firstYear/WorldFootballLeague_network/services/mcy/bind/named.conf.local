// ============================================================
//  named.conf.local for the Manchester City DNS
//  Authoritative for mcy.wfl.lan and the reverse zone 172.20.129.0/24
//  Dynamic updates come from the local Kea DDNS (127.0.0.1)
// ============================================================

zone "mcy.wfl.lan" {
    type master;
    file "/etc/bind/zones/db.mcy.wfl.lan";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};

zone "129.20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.129.20.172";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};
