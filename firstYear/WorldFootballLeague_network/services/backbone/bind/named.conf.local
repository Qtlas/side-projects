// ============================================================
//  named.conf.local for the WFL backbone DNS
//  Authoritative for wfl.lan and the reverse zone 172.20.128.0/24
//  Every club zone is forwarded to the matching club DNS server
// ============================================================

zone "wfl.lan" {
    type master;
    file "/etc/bind/zones/db.wfl.lan";
    allow-transfer { none; };
    allow-update { none; };
    notify no;
};

zone "128.20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.128.20.172";
    allow-transfer { none; };
    allow-update { none; };
    notify no;
};

zone "mcy.wfl.lan" {
    type forward;
    forward only;
    forwarders { 172.20.129.138; };
};

zone "bvb.wfl.lan" {
    type forward;
    forward only;
    forwarders { 172.20.130.138; };
};

zone "fcb.wfl.lan" {
    type forward;
    forward only;
    forwarders { 172.20.131.138; };
};

zone "juv.wfl.lan" {
    type forward;
    forward only;
    forwarders { 172.20.132.138; };
};

zone "ajx.wfl.lan" {
    type forward;
    forward only;
    forwarders { 172.20.133.138; };
};

zone "129.20.172.in-addr.arpa" {
    type forward;
    forward only;
    forwarders { 172.20.129.138; };
};

zone "130.20.172.in-addr.arpa" {
    type forward;
    forward only;
    forwarders { 172.20.130.138; };
};

zone "131.20.172.in-addr.arpa" {
    type forward;
    forward only;
    forwarders { 172.20.131.138; };
};

zone "132.20.172.in-addr.arpa" {
    type forward;
    forward only;
    forwarders { 172.20.132.138; };
};

zone "133.20.172.in-addr.arpa" {
    type forward;
    forward only;
    forwarders { 172.20.133.138; };
};
