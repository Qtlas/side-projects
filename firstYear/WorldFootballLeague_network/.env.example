# Secrets consumed by services/<club>/install.sh.
# Copy to services/<club>/.env (one per club), fill in, and keep it out of version control.
# Leave no real secret in this example file.

# Apache HTTP basic-auth accounts
WEB_PLAYERS_PASS=
WEB_COACHES_PASS=

# SFTP account passwords (OpenSSH chrooted internal-sftp)
SFTP_PLAYERS_PASS=
SFTP_COACHES_PASS=
SFTP_ADMIN_PASS=
