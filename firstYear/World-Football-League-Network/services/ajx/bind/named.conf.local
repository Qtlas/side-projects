// ============================================================
//  named.conf.local for the Ajax Amsterdam DNS
//  Authoritative for ajx.wfl.lan and the reverse zone 172.20.133.0/24
//  Dynamic updates come from the local Kea DDNS (127.0.0.1)
// ============================================================

zone "ajx.wfl.lan" {
    type master;
    file "/etc/bind/zones/db.ajx.wfl.lan";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};

zone "133.20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.133.20.172";
    allow-transfer { none; };
    allow-update { 127.0.0.1; };
    notify no;
};
